@inherits FluentDialogInstance

@inject IStringLocalizer<Resources.Components.MessageEditorDialog> LocalizerFor

<EditForm EditContext="context" role="form">
    <DataAnnotationsValidator />

    <FluentTextArea @bind-Value="model.Text"
                    Appearance="FluentInputAppearance.Filled.ToTextAreaAppearance()"
                    Height="15em"
                    Style="width:100%;" />
    <FluentValidationMessage For="@(() => model.Text)" />
</EditForm>