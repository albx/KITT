@inject IDialogService DialogService
@inject IStringLocalizer<Resources.Components.MessageComposer> Localizer

<FluentButton Appearance="Appearance.Lightweight.ToButtonAppearance()"
              IconStart="@(new Icons.Regular.Size20.Compose())"
              OnClick="OpenMessageEditorAsync">
    @Localizer[nameof(Resources.Components.MessageComposer.ComposeMessageButtonLabel)]
</FluentButton>

@*<AuthorizeView>
    <Authorized>
        
    </Authorized>
</AuthorizeView>*@

@code {
    private async Task OpenMessageEditorAsync()
    {
        await DialogService.ShowDrawerAsync<MessageEditorDialog>(new DialogOptions
        {
            Header = { Title = Localizer[nameof(Resources.Components.MessageComposer.MessageEditorDialogTitle)] },
            Alignment = DialogAlignment.End,
            Width = "50em"
        });
    }
}
