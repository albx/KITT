@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <FluentButton Id="profileMenuAnchor"
                      Appearance="ButtonAppearance.Transparent"
                      OnClick="@(() => opened = !opened)">
            <FluentAvatar Initials="@context.User.Identity!.Name!.First().ToString().ToUpper()"
                          Name="@context.User.Identity!.Name" />
        </FluentButton>
        <FluentPopover AnchorId="profileMenuAnchor" @bind-Opened="opened">
            <p>@context.User.Identity!.Name</p>
            <p>@GetUserEmailAddress(context.User)</p>
            <FluentButton Appearance="ButtonAppearance.Transparent" OnClick="BeginSignOut">Sign out</FluentButton>
        </FluentPopover>
    </Authorized>
    <NotAuthorized>
        <a href="authentication/login">Log in</a>
    </NotAuthorized>
</AuthorizeView>

@code{
    private bool opened;

    private void BeginSignOut(/*MouseEventArgs args*/)
    {
        Navigation.NavigateTo("authentication/logout", forceLoad: true);
    }

    private string GetUserEmailAddress(System.Security.Claims.ClaimsPrincipal user)
    {
        var email = user.FindFirst(c => c.Type == "preferred_username")?.Value ?? string.Empty;
        if (string.IsNullOrEmpty(email))
        {
            return string.Empty;
        }

        return email;
    }
}