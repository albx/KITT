@page "/streamings/{id:guid}"

@inject IStringLocalizer<UI.Resources.Common> CommonLocalizer
@inject IStringLocalizer<Resources.Pages.Streamings.StreamingDetail> Localizer

<PageTitle>KITT - @pageTitle</PageTitle>

<SectionContent SectionName="@SectionNames.PageTitleSectionName">
    @pageTitle
</SectionContent>
<SectionContent SectionName="@SectionNames.ToolbarSectionName">
    @if (isReadOnly)
    {
        <FluentButton Appearance="Appearance.Outline"
                      OnClick="EnableEditing">
            @CommonLocalizer[nameof(UI.Resources.Common.Edit)]
        </FluentButton>
    }

    <FluentAnchor Href="streamings"
                  Appearance="Appearance.Accent">
        @CommonLocalizer[nameof(UI.Resources.Common.Back)]
    </FluentAnchor>
</SectionContent>

<ErrorBoundary>
    <ContentForm TContent="ViewModel"
                 Model="model"
                 ContentTabTitle="@Localizer[nameof(Resources.Pages.Streamings.StreamingDetail.StreamingTabTitle)]"
                 Context="streaming"
                 ReadOnly="isReadOnly"
                 OnSave="EditStreamingAsync"
                 OnCancel="DisableEditing">
        <ContentInfo>
            <FluentGrid Spacing="3">
                <FluentGridItem Xs="12" Md="6">
                    <FluentSelect TOption="ChannelModel" TValue="string"
                                  Label="Twitch channel"
                                  Items="availableTwitchChannels"
                                  Appearance="ListAppearance.FilledDarker"
                                  Style="width:100%"
                                  OptionValue="@(c => c?.Url)"
                                  OptionText="@(c => c is null ? string.Empty : $"{c.Name} ({c.Url})")"
                                  @bind-Value="streaming.TwitchChannel"
                                  Disabled="@isReadOnly"/>
                    <FluentValidationMessage For="@(() => streaming.TwitchChannel)" />
                </FluentGridItem>
                <FluentGridItem Xs="12" Md="6">
                    <FluentSelect TOption="ChannelModel" TValue="string"
                                  Label="YouTube channel"
                                  Items="availableYouTubeChannels"
                                  Appearance="ListAppearance.FilledDarker"
                                  Style="width:100%"
                                  OptionValue="@(c => c.Url)"
                                  OptionText="@(c => $"{c.Name} ({c.Url})")"
                                  @bind-Value="streaming.YouTubeChannel"
                                  Disabled="@isReadOnly"/>
                    <FluentValidationMessage For="@(() => streaming.YouTubeChannel)" />
                </FluentGridItem>
            </FluentGrid>
            <FluentGrid Spacing="3">
                <FluentGridItem Xs="12" Md="6">
                    <FluentTextInput Label="@Localizer[nameof(Resources.Pages.Streamings.StreamingDetail.TitleLabel)]"
                                     @bind-Value="streaming.Title"
                                     Appearance="FluentInputAppearance.Filled.ToTextInputAppearance()"
                                     Style="width:100%;"
                                     Required="true"
                                     Disabled="@isReadOnly" />
                    <FluentValidationMessage For="@(() => streaming.Title)" />
                </FluentGridItem>
                <FluentGridItem Xs="12" Md="6">
                    <FluentTextInput Label="@Localizer[nameof(Resources.Pages.Streamings.StreamingDetail.SlugLabel)]"
                                     @bind-Value="streaming.Slug"
                                     Appearance="FluentInputAppearance.Filled.ToTextInputAppearance()"
                                     Style="width:100%;"
                                     Disabled="true" />
                </FluentGridItem>
            </FluentGrid>

            <FluentGrid Spacing="3">
                <FluentGridItem Xs="12" Md="6">
                    <FluentTextInput Label="@Localizer[nameof(Resources.Pages.Streamings.StreamingDetail.HostingChannelLabel)]"
                                     @bind-Value="streaming.TwitchUrl"
                                     Appearance="FluentInputAppearance.Filled.ToTextInputAppearance()"
                                     Style="width:100%;"
                                     Required="true"
                                     Disabled="@isReadOnly"/>
                    <FluentValidationMessage For="@(() => streaming.TwitchUrl)" />
                </FluentGridItem>
                <FluentGridItem Xs="12" Md="6">
                    <FluentTextInput Label="@Localizer[nameof(Resources.Pages.Streamings.StreamingDetail.YoutubeUrlLabel)]"
                                     @bind-Value="streaming.YouTubeUrl"
                                     Appearance="FluentInputAppearance.Filled.ToTextInputAppearance()"
                                     Style="width:100%;"
                                     Disabled="@isReadOnly" />
                    <FluentValidationMessage For="@(() => streaming.YouTubeUrl)" />
                </FluentGridItem>
            </FluentGrid>

            <FluentGrid Spacing="3">
                <FluentGridItem Xs="12" Md="6">
                    <FluentDatePicker Label="@Localizer[nameof(Resources.Pages.Streamings.StreamingDetail.ScheduleDateLabel)]"
                                      @bind-Value="streaming.ScheduleDate"
                                      Appearance="FluentInputAppearance.Filled"
                                      Style="width:100%;"
                                      Required="true"
                                      Disabled="@isReadOnly" />
                    <FluentValidationMessage For="@(() => streaming.ScheduleDate)" />
                </FluentGridItem>
                <FluentGridItem Xs="12" Md="3">
                    <FluentTimePicker Label="@Localizer[nameof(Resources.Pages.Streamings.StreamingDetail.StartingTimeLabel)]"
                                      @bind-Value="streaming.StartingTime"
                                      Appearance="FluentInputAppearance.Filled"
                                      Style="width:100%;"
                                      Required="true"
                                      Disabled="@isReadOnly" />
                    <FluentValidationMessage For="@(() => streaming.StartingTime)" />
                </FluentGridItem>
                <FluentGridItem Xs="12" Md="3">
                    <FluentTimePicker Label="@Localizer[nameof(Resources.Pages.Streamings.StreamingDetail.EndingTimeLabel)]"
                                      @bind-Value="streaming.EndingTime"
                                      Appearance="FluentInputAppearance.Filled"
                                      Style="width:100%;"
                                      Required="true"
                                      Disabled="@isReadOnly" />
                    <FluentValidationMessage For="@(() => streaming.EndingTime)" />
                </FluentGridItem>
            </FluentGrid>

            <FluentGrid Spacing="3">
                <FluentGridItem Xs="12" Md="12">
                    <FluentTextArea Label="@Localizer[nameof(Resources.Pages.Streamings.StreamingDetail.AbstractLabel)]"
                                    @bind-Value="streaming.StreamingAbstract"
                                    Appearance="FluentInputAppearance.Filled.ToTextAreaAppearance()"
                                    Height="10em"
                                    Style="width:100%;"
                                    Disabled="@isReadOnly" />
                </FluentGridItem>
            </FluentGrid>
        </ContentInfo>
    </ContentForm>
</ErrorBoundary>