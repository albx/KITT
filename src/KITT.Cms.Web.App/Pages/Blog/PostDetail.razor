@page "/blog/post/{id:guid}"

@inject IStringLocalizer<UI.Resources.Common> CommonLocalizer

<PageTitle>KITT - Post detail</PageTitle>

<SectionContent SectionName="@SectionNames.PageTitleSectionName">
    Post detail
</SectionContent>
<SectionContent SectionName="@SectionNames.ToolbarSectionName">
    @if (isReadOnly)
    {
        <FluentButton Appearance="Appearance.Outline"
                      OnClick="EnableEditing">
            @CommonLocalizer[nameof(UI.Resources.Common.Edit)]
        </FluentButton>
    }

    <ContentStatusControl Content="contentStatus" />

    <FluentAnchor Appearance="Appearance.Accent"
                  Href="blog">
        @CommonLocalizer[nameof(UI.Resources.Common.Back)]
    </FluentAnchor>
</SectionContent>

<ErrorBoundary>
    <ContentForm TContent="ViewModel"
                 Model="model"
                 ContentTabTitle="Post"
                 Context="post"
                 ReadOnly="isReadOnly">
        <ContentInfo>
            <FluentGrid>
                <FluentGridItem xs="12" md="6">
                    <FluentTextField Label="Title"
                                     @bind-Value="post.Title"
                                     Appearance="FluentInputAppearance.Filled"
                                     Style="width:100%;"
                                     Required="true"
                                     Disabled="isReadOnly"/>
                    <FluentValidationMessage For="@(() => post.Title)" />
                </FluentGridItem>
                <FluentGridItem xs="12" md="6">
                    <FluentTextField Label="Slug"
                                     @bind-Value="post.Slug"
                                     Appearance="FluentInputAppearance.Filled"
                                     Style="width:100%;"
                                     Disabled="true"/>
                </FluentGridItem>
            </FluentGrid>
            <FluentGrid>
                <FluentGridItem xs="12" md="6">
                    <FluentDatePicker Label="Creation date"
                                      @bind-Value="post.CreationDate"
                                      Appearance="FluentInputAppearance.Filled"
                                      Style="width:100%;"
                                      Disabled="true"/>
                </FluentGridItem>
                <FluentGridItem xs="12" md="6">
                    <FluentDatePicker Label="Publication date"
                                      @bind-Value="post.PublicationDate"
                                      Appearance="FluentInputAppearance.Filled"
                                      Style="width:100%;"
                                      Disabled="true"/>
                </FluentGridItem>
            </FluentGrid>
            <FluentGrid>
                <FluentGridItem xs="12" md="12">
                    <FluentLabel>Abstract</FluentLabel>
                    <MarkdownEditor @bind-Value="post.PostAbstract"
                                    Rows="10"
                                    Readonly="isReadOnly" />
                </FluentGridItem>
            </FluentGrid>

            <FluentGrid>
                <FluentGridItem xs="12" md="12">
                    <FluentLabel>Content</FluentLabel>
                    <MarkdownEditor @bind-Value="post.Content"
                                    Rows="20"
                                    Readonly="isReadOnly" />
                </FluentGridItem>
            </FluentGrid>
        </ContentInfo>
    </ContentForm>
</ErrorBoundary>
