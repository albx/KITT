@inherits FluentDialogInstance

@using KITT.Cms.Settings.Models

<EditForm EditContext="context" role="form">
    <DataAnnotationsValidator />

    <FluentStack Orientation="Orientation.Vertical" class="mb-2">
        <FluentSelect TOption="ChannelType" TValue="string"
                      Label="@localizer[nameof(Resources.Components.ChannelFormPanel.ChannelTypeLabel)]"
                      Items="channelTypes"
                      Id="channelType"
                      Appearance="ListAppearance.FilledDarker"
                      Style="width:100%;"
                      OptionValue="@(t => t.ToString())"
                      OptionText="@(t => t.ToString())"
                      Value="@Content.Model.Type.ToString()"
                      ValueChanged="@(value => Content.Model.Type = Enum.Parse<ChannelType>(value))"/>
        <FluentValidationMessage For="@(() => Content.Model.Type)"/>
    </FluentStack>
    <FluentStack Orientation="Orientation.Vertical" class="mb-2">
        <FluentTextInput Label="@localizer[nameof(Resources.Components.ChannelFormPanel.ChannelNameLabel)]"
                        @bind-Value="Content.Model.Name"
                        Appearance="FluentInputAppearance.Filled.ToTextInputAppearance()"
                        Style="width:100%;"
                        Required="true"
                        Id="channelName"/>
        <FluentValidationMessage For="@(() => Content.Model.Name)"/>
    </FluentStack>
    <FluentStack Orientation="Orientation.Vertical" class="mb-2">
        <FluentTextInput Label="@localizer[nameof(Resources.Components.ChannelFormPanel.ChannelUrlLabel)]"
                        @bind-Value="Content.Model.Url"
                        Appearance="FluentInputAppearance.Filled.ToTextInputAppearance()"
                        TextInputType="TextInputType.Url"
                        Style="width:100%;"
                        Required="true"
                        Id="channelUrl"
                        Placeholder="@UrlPlaceholder"/>
        <FluentValidationMessage For="@(() => Content.Model.Url)"/>
    </FluentStack>
</EditForm>
